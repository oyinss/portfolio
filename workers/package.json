{
  "name": "portfolio-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply portfolio-db --local",
    "migrate:remote": "wrangler d1 migrations apply portfolio-db --remote",
    "deploy:safe": "npm run migrate:remote && npm run deploy"
  },
  "dependencies": {
    "hono": "^4.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "typescript": "^5.7.0",
    "wrangler": "^4.0.0"
  }
}
